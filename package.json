{
  "name": "houser",
  "version": "0.1.0",
  "description": "Find a home by how far it is from where you go every day: listings on a map with transit lines, daily places and routed trip times.",
  "license": "AGPL-3.0-or-later",
  "repository": { "type": "git", "url": "git+https://github.com/prioneto/houser-oss.git" },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "start": "node server/index.mjs",
    "test": "node --test \"server/**/*.test.mjs\"",
    "homes:fetch": "node server/fetch-homes.mjs"
  },
  "dependencies": {
    "lucide-react": "0.544.0",
    "maplibre-gl": "6.6.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.3",
    "typescript": "6.0.3",
    "vite": "8.3.0"
  }
}
