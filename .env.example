# Copy to .env to use other servers.
# OVERPASS_URL=https://your-overpass-host/api/interpreter  (comma-separated: tried in order when one is busy)
# VALHALLA_URL=https://valhalla1.openstreetmap.de
# VALHALLA_CLIENT_ID=houser.example.com
# TFL_APP_KEY=your-key  (free from api-portal.tfl.gov.uk; without it TfL throttles to about 50 requests a minute)
# GOOGLE_MAPS_KEY=your-key  (Google Cloud, Places API (New) enabled, billing on; shows star ratings for the five gyms nearest a home. Billed by Google per request)
